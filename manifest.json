{
  "id": "us.theatr.foraxx",
  "name": "Foraxx Palette",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": { "app": "PS", "minVersion": "24.4.0", "data": { "apiVersion": 2 } },
  "entrypoints": [
    {
      "type": "panel",
      "id": "foraxxPanel",
      "label": { "default": "Foraxx Palette" },
      "minimumSize": { "width": 300, "height": 420 },
      "maximumSize": { "width": 900, "height": 2000 },
      "preferredDockedSize": { "width": 340, "height": 620 },
      "preferredFloatingSize": { "width": 340, "height": 620 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/icon.png", "scale": [1, 2], "theme": ["all"], "species": ["generic"] }
      ]
    }
  ],
  "icons": [
    { "width": 23, "height": 23, "path": "icons/icon.png", "scale": [1, 2], "theme": ["all"], "species": ["generic"] }
  ],
  "requiredPermissions": {
    "allowCodeGenerationFromStrings": false
  }
}
